# Copia a backend.env (NO subir a git) desde PathWay-Backend/.env
# docker compose usa este archivo para el servicio api.

PORT=3000
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/pathway?retryWrites=true&w=majority
JWT_SECRET=cambia-esto-por-un-secreto-largo
ALLOW_REGISTRATION=true
NODE_ENV=production
SESSION_COOKIE_NAME=pw_session

