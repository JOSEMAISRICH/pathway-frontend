# Copia a .env.local (Next). Mongo, uploads y límites van en el .env del servidor Express.

# --- API desde Next ---
# Opcional en local: `next dev` ya reenvía /api/* a http://localhost:3000 por defecto (next.config.ts).
# Usa API_PROXY_TARGET si tu Express corre en otro host/puerto:
# API_PROXY_TARGET=http://localhost:3000
#
# Opcional: URL pública del API (producción o casos especiales). En `next dev`, `apiUrl()` IGNORA esta
# variable y usa /api relativo para no perder la cookie entre puertos. Para forzar llamadas directas
# en desarrollo: NEXT_PUBLIC_FORCE_DIRECT_API=true
# NEXT_PUBLIC_API_BASE_URL=https://api.tudominio.com
# NEXT_PUBLIC_FORCE_DIRECT_API=

# OBLIGATORIO: el mismo valor que JWT_SECRET en el .env de Express (copiar/pegar, sin comillas).
# Si dejas un texto de marcador de posición, el login puede dar 200 pero /dashboard te devolverá a /sign-in.
JWT_SECRET=wH2l+FN7jIiSQjOJ/Ss2SG+5yreZoOz7kLStTaZzpBg=

# Opcional: si tu Express lo usa para lógica propia (rate limit, etc.). El front ya no oculta el registro por esta variable.
# ALLOW_REGISTRATION=

# Correo de verificación post-registro (requiere implementar POST /api/auth/send-verification en Express + proveedor email).
# NEXT_PUBLIC_SEND_VERIFICATION_EMAIL=true

# Stripe: opcional. Con Checkout hospedado el front solo redirige a la URL del backend; no hace falta pk_.
# Nunca pongas sk_ (secret) aquí — solo en PathWay-Backend/.env
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Backend Express (no van en Next; copia al .env de PathWay-Backend) ---
# MAGIC_LINK_TTL_DAYS=30
# PUBLIC_APP_ORIGIN=http://localhost:5500
# Parches listos: ../pathway-express-patches/README.md
