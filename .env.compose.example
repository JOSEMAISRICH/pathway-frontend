# Copia a .env:  cp .env.compose.example .env
# NO subas .env a GitHub.

# --- Equivalente a luxuryrent.site / info@luxuryrent.site del profe ---
DOMAIN=visalawyer.online
ACME_EMAIL=josemopalo@gmail.com

# Front + back (mismo JWT)
JWT_SECRET=cambia-esto-por-un-secreto-largo

# MongoDB Atlas (obligatorio)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/pathway?retryWrites=true&w=majority

ALLOW_REGISTRATION=true
LOG_LEVEL=INFO

# Stripe (opcional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=7

# Email app (opcional; equivalente a info@ del dominio del profe)
# RESEND_FROM=PathWay <info@visalawyer.online>
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
