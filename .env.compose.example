# Copia a .env en la misma carpeta que docker-compose.yml:
#   cp .env.compose.example .env
#   nano .env
#   docker compose up --build -d
#
# NO subas .env a GitHub.

# Let's Encrypt (obligatorio — usa tu email real)
ACME_EMAIL=tu-email@ejemplo.com

# Front + back (mismo JWT en ambos)
JWT_SECRET=cambia-esto-por-un-secreto-largo

# MongoDB Atlas (obligatorio)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/pathway?retryWrites=true&w=majority

# Registro de nuevas agencias (demo TFG)
ALLOW_REGISTRATION=true

# Stripe (opcional — pagos de prueba)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=7

# Email / OCR (opcionales)
OPENAI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
